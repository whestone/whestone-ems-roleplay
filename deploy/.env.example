# Kopiere diese Datei zu  .env  und trage echte Werte ein.
# .env bleibt LOKAL (per .gitignore ausgeschlossen) – niemals committen!

# --- Projekt-Datenwurzel (alle Bind-Mounts liegen hierunter) ---
# db/, txData/, server/ und dumps/ werden hier erwartet.
DATA_ROOT=/volume1/docker/FiveM

# --- Datenbank ---
# Trage hier DIESELBEN Passwoerter ein wie in der Verbindungszeile deiner
# server.cfg (mysql_connection_string). Echte Werte NUR in .env, nie hier.
DB_ROOT_PASSWORD=dein_root_passwort
DB_PASSWORD=dein_app_passwort

# --- FXServer Linux-Artifact ---
# Von https://runtime.fivem.net/artifacts/fivem/build_proot_linux/master/
# die fx.tar.xz eines empfohlenen Builds – Rechtsklick > Link kopieren.
# Beispiel-Form (NICHT einfach uebernehmen, aktuelle Nummer holen):
# FX_URL=https://runtime.fivem.net/artifacts/fivem/build_proot_linux/master/XXXXX-<hash>/fx.tar.xz
FX_URL=
